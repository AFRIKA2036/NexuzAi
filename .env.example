# --- FRONTEND (Public) ---
# Add these to Vercel/Hosting platform Environment Variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
PAYSTACK_PUBLIC_KEY=pk_live_...

# --- CI/CD (GitHub Secrets) ---
# Add these to GitHub Repository Secrets
SUPABASE_ACCESS_TOKEN=sbp_...
# Optional: only needed if you add SQL files under supabase/migrations
SUPABASE_DB_PASSWORD=your-db-password

# --- BACKEND (Secret) ---
# Add these to Supabase Secrets (supabase secrets set ...)
# Or local .env for development
OPENROUTER_API_KEY=your-openrouter-key
PAYSTACK_SECRET_KEY=sk_live_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
APP_URL=https://your-app.vercel.app

